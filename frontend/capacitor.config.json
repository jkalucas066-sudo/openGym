{
  "appId": "app.jkalucas.personalfitness",
  "appName": "我的健身教练",
  "webDir": "dist-ios",
  "backgroundColor": "#0c0e12",
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "SplashScreen": {
      "launchShowDuration": 8000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 180,
      "backgroundColor": "#0c0e12",
      "showSpinner": false
    }
  }
}
